[Unit]
Description=Telegram Bot
After=network.target

[Service]
User=heldan1
Group=heldan1

WorkingDirectory=/home/heldan1/TeleBot1/
Environment="PYTHONPATH=/home/heldan1/TeleBot1/"
ExecStart=/home/heldan1/TeleBot1/.venv/bin/python /home/heldan1/TeleBot1/polling.py

[Install]
WantedBy=multi-user.target


