[Unit]
Description=Telegram Bot
After=network.target

[Service]
User=heldan
Group=heldan

WorkingDirectory=/home/heldan/TeleBot1/
Environment="PYTHONPATH=/home/heldan1/TeleBot1/"
ExecStart=/home/heldan/TeleBot1/.venv/bin/python /home/heldan/TeleBot1/polling.py

[Install]
WantedBy=multi-user.target



